# Cross-build vcpkg triplet trees generated by vcpkg manifest mode.
# Only the repo-local x64-windows tree is intentionally tracked for
# the native-windows-local preset; everything else is regenerated.
vcpkg_installed/vcpkg/
vcpkg_installed/x64-linux/
vcpkg_installed/arm64-linux/
vcpkg_installed/arm-linux/
vcpkg_installed/x64-mingw-dynamic/
vcpkg_installed/x64-mingw-static/
vcpkg_installed/x64-windows/
vcpkg_installed/arm64-windows/

# compile_commands.json is generated in the build tree by CMake
# (CMAKE_EXPORT_COMPILE_COMMANDS=ON) but editors sometimes symlink or
# copy it to the project root.
compile_commands.json

# Language-server / tooling caches
.cache/

# Visual Studio Code
.vscode